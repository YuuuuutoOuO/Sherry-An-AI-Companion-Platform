# ==============================================================================
# Sherry AI Companion Platform - Environment Variables Template (.env.example)
# ==============================================================================

# --- Discord Bot Token ---
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# --- FreeToken MoE Inference Engine (Default Local Backend) ---
LLM_BASE_URL=http://localhost:1919/v1
LLM_MODEL_NAME=mistralai/Mixtral-8x7B-Instruct-v0.1
LLM_TIMEOUT=180
LLM_STREAM_CHUNK_TIMEOUT=60.0

# --- Model Selection Overrides (Optional) ---
# Format: "freetoken:<hf_model_id>", "ollama:<model_name>", "openai:<model_name>", etc.
PRIMARY_MODEL=freetoken:mistralai/Mixtral-8x7B-Instruct-v0.1
NOMORAL_MODEL=freetoken:mistralai/Mixtral-8x7B-Instruct-v0.1
QUICK_MODEL=ollama:krith/mistral-nemo-instruct-2407-abliterated:IQ4_XS
CLASSIFIER_MODEL=ollama:qwen2.5:3b
VIBE_MODEL=ollama:llama3.2:3b
VISION_MODEL=

# --- Legacy Local Inference Endpoints (Optional Backwards Compatibility) ---
# FREETOKEN_BASE_URL=http://localhost:1919/v1
# LMS_BASE_URL=http://localhost:1919/v1
# OLLAMA_BASE_URL=http://localhost:11434
# VLLM_BASE_URL=http://localhost:8000/v1

# --- Cloud LLM API Keys (Optional) ---
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# CLAUDE_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Observability & Features ---
AGENT_DISPATCH_MODE=PARALLEL
ACTION_EARLY_TERMINATION_ENABLED=True
DEBUG_DETAIL=False

# --- System Administrators & Health Alert (DM / Channel) ---
# 系統最高管理員 ID 清單（支援逗號分隔或中括號格式，享有最高管理權限並自動接收 ERROR 警報私訊）
ADMIN_USER_IDS=[]
# 管理員身分組 ID
ADMIN_ROLE_IDS=[]
# （可選）額外接收系統警報與 ERROR 日誌私訊的 Discord User ID
# HEALTH_ALERT_USER_IDS=[]
# （可選）系統警報 Discord 頻道 ID（0 = 停用頻道推播，預設主要透過私訊推播）
HEALTH_ALERT_CHANNEL_ID=0
# 日誌私訊推播門檻等級（DEBUG, INFO, WARNING, ERROR, CRITICAL，預設 WARNING）
DISCORD_LOG_LEVEL=WARNING

# --- External Tools & APIs (Optional) ---
# YOUTUBE_API_KEY=
# OPENWEATHERMAP_API_KEY=
# FINNHUB_API_KEY=
# HF_TOKEN=
# POLLINATIONS_MODEL=flux-anime
# SD_WEBUI_URL=http://localhost:7860

# --- Web UI Console (optional; Docker sets host 0.0.0.0) ---
# WEB_UI_HOST=127.0.0.1
# WEB_UI_PORT=8763
# WEB_UI_PASSWORD=change_me

# --- 賽博群友 Social Core（預設全部關閉；正式群永遠只有雪莉） ---
# 沙盒群像總開關：未設 1 時，任何頻道都不會建立 Webhook NPC。
# SOCIAL_SANDBOX_ENABLED=0
# 相容模式：只有要把舊 CARE_SURFER 沙盒頻道直接視為 SANDBOX_GROUP 時才設 1。
# SOCIAL_SANDBOX_COMPAT_MODE=0
# SOCIAL_SANDBOX_MAX_NPCS=3
# SOCIAL_NPC_MAX_CONSECUTIVE=3
# SOCIAL_NPC_MAX_PER_ROUND=2
# SOCIAL_NPC_HOURLY_LIMIT=20
# SOCIAL_NPC_DAILY_LIMIT=120
# SOCIAL_NPC_MIN_GAP_SECONDS=45

